SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx
ANTHROPIC_API_KEY=xxx
CRON_SECRET=xxx

# freee OAuth (本番は Supabase DB に永続化、ここはローカル開発と初回 seed 用)
FREEE_CLIENT_ID=your_client_id_here
FREEE_CLIENT_SECRET=your_client_secret_here
FREEE_ACCESS_TOKEN=your_token_here
FREEE_REFRESH_TOKEN=your_refresh_token_here
FREEE_COMPANY_ID=your_company_id_here
# FREEE_TOKEN_EXPIRES_IN=21600

# 除外店舗リスト（カンマ区切り、未設定時は process.js の DEFAULT_EXCLUDED_STORES を使用）
# サンプル値: 全 14 店舗を明示的に列挙
# 本番では未設定推奨（DEFAULT がそのまま使われる）
EXCLUDED_STORES_CSV=吸暮,スーク,souq,goodbye,金魚,LR,moumou,こまいぬ,KITUNE,ミヤウチ,キシブチ,ハトマ,ヤマト,シマツ
